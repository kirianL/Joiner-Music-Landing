---
import { navLinks } from '../../config/navigation';
import { siteConfig } from '../../config/site';
---

<!-- Sentinel for scroll detection -->
<div id="nav-sentinel" class="absolute top-0 h-[1px] w-full" aria-hidden="true"></div>

<nav
  id="navbar"
  class="sticky top-0 left-0 right-0 z-50 bg-white border-b border-gray-200/50 transition-all duration-[var(--motion-standard)] ease-[var(--ease-standard)]"
  role="navigation"
  aria-label="Navegación principal"
>
  <div class="w-[calc(100%-2rem)] md:w-[calc(100%-4rem)] max-w-7xl mx-auto flex items-center justify-between h-[80px]">
    <!-- Logo -->
    <a href="#hero" class="flex items-center hover:opacity-90 transition-opacity">
      <img src="/JOINER MUSIC/LOGO/LOGO.svg" alt="Joiner Music Academy" class="h-10 lg:h-12 w-auto object-contain" />
    </a>

    <!-- Desktop Navigation (Centered) -->
    <div class="hidden lg:flex items-center justify-center gap-[var(--space-6)] text-[15px] font-semibold text-gray-700">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link
          class="relative py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors duration-[var(--motion-fast)] flex items-center gap-1 group"
        >
          {link.label}
          <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--color-accent)] transition-all duration-[var(--motion-standard)] group-hover:w-full"></span>
        </a>
      ))}
    </div>

    <!-- Right Side (Pill Button) -->
    <div class="hidden lg:flex items-center">
      <a href="#contact" class="inline-flex items-center justify-center font-[var(--font-heading)] font-bold rounded-full text-sm px-6 py-2.5 bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] shadow-sm hover:shadow transition-all group duration-[var(--motion-fast)]">
        Inscríbete
        <span class="ml-2 group-hover:translate-x-1 transition-transform duration-200 flex items-center">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="w-3 h-auto" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 6H11M11 6L6 1M11 6L6 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="menu-toggle"
      class="lg:hidden flex flex-col items-end justify-center w-10 h-10 gap-1.5 z-50 cursor-pointer group"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-6 h-[2px] bg-[var(--color-text-dark)] transition-all duration-[var(--motion-standard)] origin-right"></span>
      <span class="block w-4 h-[2px] bg-[var(--color-text-dark)] transition-all duration-[var(--motion-standard)] origin-right group-hover:w-6"></span>
    </button>
  </div>

  <!-- Minimalist Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 z-40 bg-white/98 backdrop-blur-lg flex flex-col justify-center px-8 sm:px-12
           opacity-0 pointer-events-none transition-all duration-[var(--motion-slow)] ease-[var(--ease-standard)]"
    aria-hidden="true"
  >
    <div class="flex flex-col gap-6 translate-y-8 transition-transform duration-[var(--motion-slow)] delay-100" id="mobile-menu-content">
      <span class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-4">Navegación</span>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-4xl sm:text-5xl font-[var(--font-heading)] font-bold text-[var(--color-text-primary)] hover:text-[var(--color-primary)] transition-colors inline-block w-fit"
        >
          {link.label}
        </a>
      ))}
      <div class="mt-8">
        <a href="#contact" class="inline-flex items-center justify-center font-[var(--font-heading)] font-bold rounded-full text-lg px-8 py-4 bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] transition-all w-full sm:w-auto group">
          Inscríbete Ahora
          <span class="ml-2 group-hover:translate-x-1 transition-transform duration-200 flex items-center">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1.5 8H14.5M14.5 8L8.5 2M14.5 8L8.5 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Navbar scrolled state */
  #navbar.is-scrolled {
    background-color: #ffffff;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
    border-bottom: 1px solid rgba(48, 18, 40, 0.08);
  }

  /* Active nav link */
  [data-nav-link].is-active {
    color: var(--color-primary);
    font-weight: 700;
  }
  [data-nav-link].is-active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
  }

  /* Mobile menu open state */
  #mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  
  #mobile-menu.is-open #mobile-menu-content {
    transform: translateY(0);
  }

  /* Hamburger animation */
  #menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
    background-color: var(--color-text-dark);
  }
  #menu-toggle[aria-expanded="true"] span:nth-child(2) {
    transform: translateY(-4px) rotate(-45deg);
    width: 24px;
    background-color: var(--color-text-dark);
  }
</style>
