---
import Container from '../ui/Container.astro';
import CountUp from '../motion/CountUp.astro';
---

<section class="pt-[var(--space-2)] pb-[var(--space-8)] lg:pt-[var(--space-2)] lg:pb-[var(--space-9)] bg-[var(--color-surface-light)]">
  <Container>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[var(--space-4)] lg:gap-[var(--space-5)]">
      
      <!-- Card 1 -->
      <a href="/programas" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-5)] min-h-[140px] lg:min-h-[160px] flex flex-col justify-between group">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)] opacity-90">
            <!-- Notebook/Pen Icon Placeholder -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
          </div>
          <div class="text-[var(--color-primary)] opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-[var(--font-size-md)] font-bold font-[var(--font-heading)] text-[#4F2B3D] mb-1">
            Explorar Programas
          </h3>
          <p class="text-xs text-[#858585] leading-relaxed">
            Rutas de aprendizaje adaptadas para cada estudiante
          </p>
        </div>
      </a>

      <!-- Card 2 -->
      <a href="/cursos" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-5)] min-h-[140px] lg:min-h-[160px] flex flex-col justify-between group">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)] opacity-90">
            <!-- Book Icon Placeholder -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="text-[var(--color-primary)] opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-[var(--font-size-md)] font-bold font-[var(--font-heading)] text-[#4F2B3D] mb-1">
            Ver Cursos
          </h3>
          <p class="text-xs text-[#858585] leading-relaxed">
            Experiencias de aprendizaje interactivas
          </p>
        </div>
      </a>

      <!-- Card 3 -->
      <a href="/profesores" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-5)] min-h-[140px] lg:min-h-[160px] flex flex-col justify-between group">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)] opacity-90">
            <!-- Teacher/Search Icon Placeholder -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 14a4 4 0 0 0-4-4"/><path d="M11 10v4"/></svg>
          </div>
          <div class="text-[var(--color-primary)] opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-[var(--font-size-md)] font-bold font-[var(--font-heading)] text-[#4F2B3D] mb-1">
            Conocer Profesores
          </h3>
          <p class="text-xs text-[#858585] leading-relaxed">
            Orientación personalizada de expertos
          </p>
        </div>
      </a>

      <!-- Card 4 -->
      <a href="/productos" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-5)] min-h-[140px] lg:min-h-[160px] flex flex-col justify-between group">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)] opacity-90">
            <!-- Shopping Cart Icon Placeholder -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          </div>
          <div class="text-[var(--color-primary)] opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-[var(--font-size-md)] font-bold font-[var(--font-heading)] text-[#4F2B3D] mb-1">
            Ver Productos
          </h3>
          <p class="text-xs text-[#858585] leading-relaxed">
            Instrumentos y accesorios para todas las necesidades
          </p>
        </div>
      </a>

    </div>
  </Container>
</section>
