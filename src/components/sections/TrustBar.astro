---
import Container from '../ui/Container.astro';
import CountUp from '../motion/CountUp.astro';
---

<section class="pt-[var(--space-2)] pb-[var(--space-8)] lg:pt-[var(--space-2)] lg:pb-[var(--space-9)] bg-[var(--color-surface-light)]">
  <Container>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[var(--space-4)] lg:gap-[var(--space-5)]">
      
      <!-- Card 1 -->
      <a href="/programas" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-6)] min-h-[180px] lg:min-h-[210px] flex flex-col justify-between group transition-all duration-300 hover:shadow-md hover:bg-[#EBEBE9]">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)]">
            <img src="/Icons/ExplorarProgramas.svg" class="w-12 h-12 object-contain" alt="Explorar Programas" />
          </div>
          <div class="opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <img src="/Icons/FlechaDerecha.svg" class="w-6 h-auto object-contain" alt="" />
          </div>
        </div>
        <div class="mt-8">
          <h3 class="text-xl lg:text-[22px] font-extrabold font-[var(--font-heading)] text-[#4F2B3D] mb-2 tracking-tight">
            Explorar Programas
          </h3>
          <p class="text-sm lg:text-[15px] text-[#5C5C5C] leading-relaxed">
            Rutas de aprendizaje adaptadas para cada estudiante
          </p>
        </div>
      </a>

      <!-- Card 2 -->
      <a href="/cursos" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-6)] min-h-[180px] lg:min-h-[210px] flex flex-col justify-between group transition-all duration-300 hover:shadow-md hover:bg-[#EBEBE9]">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)]">
            <img src="/Icons/LibroAbierto.svg" class="w-12 h-12 object-contain" alt="Ver Cursos" />
          </div>
          <div class="opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <img src="/Icons/FlechaDerecha.svg" class="w-6 h-auto object-contain" alt="" />
          </div>
        </div>
        <div class="mt-8">
          <h3 class="text-xl lg:text-[22px] font-extrabold font-[var(--font-heading)] text-[#4F2B3D] mb-2 tracking-tight">
            Ver Cursos
          </h3>
          <p class="text-sm lg:text-[15px] text-[#5C5C5C] leading-relaxed">
            Experiencias de aprendizaje interactivas
          </p>
        </div>
      </a>

      <!-- Card 3 -->
      <a href="/profesores" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-6)] min-h-[180px] lg:min-h-[210px] flex flex-col justify-between group transition-all duration-300 hover:shadow-md hover:bg-[#EBEBE9]">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)]">
            <img src="/Icons/ConocerProfesores.svg" class="w-12 h-12 object-contain" alt="Conocer Profesores" />
          </div>
          <div class="opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <img src="/Icons/FlechaDerecha.svg" class="w-6 h-auto object-contain" alt="" />
          </div>
        </div>
        <div class="mt-8">
          <h3 class="text-xl lg:text-[22px] font-extrabold font-[var(--font-heading)] text-[#4F2B3D] mb-2 tracking-tight">
            Conocer Profesores
          </h3>
          <p class="text-sm lg:text-[15px] text-[#5C5C5C] leading-relaxed">
            Orientación personalizada de expertos
          </p>
        </div>
      </a>

      <!-- Card 4 -->
      <a href="/productos" class="bg-[#F2F2F0] rounded-3xl p-[var(--space-6)] min-h-[180px] lg:min-h-[210px] flex flex-col justify-between group transition-all duration-300 hover:shadow-md hover:bg-[#EBEBE9]">
        <div class="flex justify-between items-start">
          <div class="text-[var(--color-primary)]">
            <img src="/Icons/Ver%20productos.svg" class="w-12 h-12 object-contain" alt="Ver Productos" />
          </div>
          <div class="opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
            <img src="/Icons/FlechaDerecha.svg" class="w-6 h-auto object-contain" alt="" />
          </div>
        </div>
        <div class="mt-8">
          <h3 class="text-xl lg:text-[22px] font-extrabold font-[var(--font-heading)] text-[#4F2B3D] mb-2 tracking-tight">
            Ver Productos
          </h3>
          <p class="text-sm lg:text-[15px] text-[#5C5C5C] leading-relaxed">
            Instrumentos y accesorios para todas las necesidades
          </p>
        </div>
      </a>

    </div>
  </Container>
</section>
