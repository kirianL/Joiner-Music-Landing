---
import Container from '../ui/Container.astro';
import { Play, Pause, ArrowRight } from '@lucide/astro';
---

<section id="hero" class="relative pt-[var(--space-4)] pb-[var(--space-4)]">
  <Container class="relative z-10">
    <!-- Main Hero Card Wrapper -->
    <div class="flex flex-col lg:flex-row w-full h-auto lg:h-[calc(100vh-140px)] lg:max-h-[720px] lg:min-h-[580px] rounded-[var(--radius-lg)] overflow-hidden border border-white/[0.08] shadow-2xl relative">
      
      <!-- Left Panel: Content -->
      <div class="w-full lg:w-1/2 bg-[var(--color-primary)] p-[var(--space-6)] sm:p-[var(--space-8)] lg:p-[var(--space-9)] flex flex-col justify-center relative overflow-hidden">
        
        <!-- Background Illustration -->
        <div class="absolute inset-0 pointer-events-none opacity-100">
          <img 
            src="/Illustrations/IllustrationHero.png" 
            alt="" 
            class="w-full h-full object-cover"
            aria-hidden="true"
          />
        </div>

        <div class="relative z-10">
          <!-- Inset Image Slider with Logo -->
          <div class="w-[140px] sm:w-[180px] lg:w-[200px] aspect-[16/10] rounded-[var(--radius-md)] overflow-hidden mb-[var(--space-4)] lg:mb-[var(--space-5)] border border-white/10 shadow-lg relative group">
            <!-- Image Slider -->
            <div class="w-full h-full bg-[var(--color-surface-elevated)] relative rounded-[var(--radius-md)] overflow-hidden">
              <img src="https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?q=80&w=600&auto=format&fit=crop" alt="Clase 1" class="absolute inset-0 w-full h-full object-cover grayscale opacity-80 mix-blend-luminosity slider-img-1" />
              <img src="https://images.unsplash.com/photo-1593697821252-0c9137d9fc45?q=80&w=600&auto=format&fit=crop" alt="Clase 2" class="absolute inset-0 w-full h-full object-cover grayscale opacity-80 mix-blend-luminosity slider-img-2" />
              <img src="https://images.unsplash.com/photo-1460723237483-7a6dc9d0b212?q=80&w=600&auto=format&fit=crop" alt="Clase 3" class="absolute inset-0 w-full h-full object-cover grayscale opacity-80 mix-blend-luminosity slider-img-3" />
              <img src="https://images.unsplash.com/photo-1511192336575-5a79af67a629?q=80&w=600&auto=format&fit=crop" alt="Clase 4" class="absolute inset-0 w-full h-full object-cover grayscale opacity-80 mix-blend-luminosity slider-img-4" />
            </div>
          </div>

          <!-- Description -->
          <p class="text-sm sm:text-base text-[var(--color-text-secondary)] font-medium leading-relaxed mb-[var(--space-4)] lg:mb-[var(--space-5)] max-w-[45ch] animate-hero-delay-1">
            Somos una academia musical comprometida con darle a cada estudiante la oportunidad de aprender, crear y brillar.
          </p>

          <!-- Large Heading -->
          <h1 class="text-3xl sm:text-4xl xl:text-5xl font-extrabold font-[var(--font-heading)] tracking-tight leading-[1.15] text-[#ffffff] mb-[var(--space-5)] lg:mb-[var(--space-6)] animate-hero-delay-2" style="color: white !important;">
            Educación con propósito. <br class="hidden sm:inline" /><span class="text-[var(--color-accent)]">Impacto con arte.</span>
          </h1>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row flex-wrap gap-[var(--space-4)] animate-hero-delay-2">
            <a href="#contact" class="inline-flex items-center justify-center w-full sm:w-auto font-[var(--font-heading)] font-bold rounded-full text-sm px-6 py-3.5 bg-[var(--color-accent)] text-black hover:bg-[var(--color-accent-hover)] hover:scale-[1.02] transition-all duration-300 active:scale-95 group">
              Inscríbete Ahora
              <ArrowRight size={16} class="ml-2 group-hover:translate-x-1 transition-transform" />
            </a>
            <a href="#programs" class="inline-flex items-center justify-center w-full sm:w-auto font-[var(--font-heading)] font-bold rounded-full text-sm px-6 py-3.5 border border-white/20 text-white bg-white/5 hover:bg-white/10 hover:border-white/40 transition-all duration-300 active:scale-95">
              Nuestros Programas
            </a>
          </div>
        </div>
      </div>

      <!-- Right Panel: Large Image & Overlays -->
      <div class="w-full lg:w-1/2 relative aspect-[4/3] sm:aspect-[16/9] lg:aspect-auto lg:h-auto bg-[var(--color-primary)] overflow-hidden">
        <!-- Background Image -->
        <img 
          src="https://images.unsplash.com/photo-1593697821252-0c9137d9fc45?q=80&w=1200&auto=format&fit=crop" 
          alt="Clase de música" 
          class="absolute inset-0 w-full h-full object-cover animate-hero-delay-1 hover:scale-105 transition-transform duration-[4000ms]"
        />

        <!-- Ambient overlay on image to merge left panel -->
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)]/50 via-transparent to-transparent hidden lg:block"></div>
      </div>

    </div>
  </Container>
</section>

<style>
  /* Slider Animations */
  .slider-img-1, .slider-img-2, .slider-img-3, .slider-img-4 {
    opacity: 0;
    animation: crossfade 16s infinite;
  }
  
  .slider-img-1 { animation-delay: 0s; }
  .slider-img-2 { animation-delay: 4s; }
  .slider-img-3 { animation-delay: 8s; }
  .slider-img-4 { animation-delay: 12s; }

  @keyframes crossfade {
    0% { opacity: 0; }
    8% { opacity: 1; }
    25% { opacity: 1; }
    33% { opacity: 0; }
    100% { opacity: 0; }
  }
</style>
