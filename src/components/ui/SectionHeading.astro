---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
  theme?: 'light' | 'dark'; // 'light' background means dark text; 'dark' background means light text
}

const { title, subtitle, align = 'left', class: className = '', theme = 'light' } = Astro.props;
---

<div class:list={[align === 'center' ? 'text-center' : '', className]}>
  <h2
    class:list={[
      "text-[clamp(2rem,4vw,3.5rem)] font-bold tracking-tight",
      theme === 'dark' ? 'text-[var(--color-text-primary)]' : 'text-[var(--color-text-dark)]'
    ]}
  >
    {title}
  </h2>
  {subtitle && (
    <p
      class:list={[
        'mt-[var(--space-4)] text-[var(--font-size-md)] leading-relaxed',
        theme === 'dark' ? 'text-[var(--color-text-muted)]' : 'text-gray-600',
        align === 'center' ? 'mx-auto' : '',
      ]}
      style="max-width: 65ch;"
    >
      {subtitle}
    </p>
  )}
</div>
