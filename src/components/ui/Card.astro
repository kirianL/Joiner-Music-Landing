---
interface Props {
  class?: string;
  interactive?: boolean;
}

const { class: className = "", interactive = false } = Astro.props;

const hoverStyles = interactive
  ? "hover:-translate-y-[2px] hover:border-[var(--color-accent)] hover:shadow-[0_0_0_1px_rgba(201,160,92,0.2),0_8px_30px_rgba(0,0,0,0.2)] transition-all duration-[var(--motion-standard)] ease-[var(--ease-standard)]"
  : "";
---

<div
  class:list={[
    "bg-[var(--color-surface-card)]",
    "border border-[var(--color-border-subtle)]",
    "rounded-[var(--radius-md)]",
    "p-[var(--space-6)]",
    hoverStyles,
    className,
  ]}
>
  <slot />
</div>
