---
interface Props {
  class?: string;
  interactive?: boolean;
}

const { class: className = "", interactive = false } = Astro.props;

const hoverStyles = interactive
  ? "hover:-translate-y-1 hover:border-[var(--color-border-default)] hover:shadow-[0_12px_32px_rgba(48,18,40,0.06)] transition-all duration-300"
  : "";
---

<div
  class:list={[
    "bg-[var(--color-surface-card)]/70 backdrop-blur-md",
    "border border-[var(--color-border-subtle)]",
    "rounded-[var(--radius-md)]",
    "p-[var(--space-6)]",
    hoverStyles,
    className,
  ]}
>
  <slot />
</div>
